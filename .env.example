# BLP Workbench production settings (copy to .env next to compose.yaml).

# Version to run: a release tag such as v0.55b, or "latest" for the newest release.
BLP_VERSION=latest

# Container name: unique on this machine (letters, digits, - _ .), e.g. blp-workbench-test.
CONTAINER_NAME=blp-workbench

# Host ports: the app over HTTP, and over HTTPS (served once Settings › HTTPS has a
# certificate). For Let's Encrypt use 80 and 443 (Let's Encrypt checks the domain on port 80).
# Each instance on this machine needs its own ports.
APP_PORT=7080
APP_HTTPS_PORT=7443

# Optional: the host user/group that owns ./data (default 1000:1000, the image's own user).
# APP_UID=1000
# APP_GID=1000

# Optional recovery admin. A new install asks for its first admin account on the setup page,
# so these aren't needed. If someone gets locked out, set both and restart: this account can
# always sign in (as an admin) while it's set. Remove it again afterwards.
# ADMIN_USER=recovery
# ADMIN_PASS=

# The address users open (used in label QR codes and emailed links). With HTTPS, use the
# https:// address (plain HTTP pages then move to it): e.g. https://workbench.example.com
PUBLIC_URL=http://your-host.example.com:7080

# Optional: get a Let's Encrypt certificate for this domain on the first start (the installer
# sets these). Needs APP_PORT=80 and APP_HTTPS_PORT=443, and the domain pointing at this
# machine. Afterwards Admin › Settings › HTTPS manages it.
# TLS_DOMAIN=workbench.example.com
# TLS_EMAIL=you@example.com

# Lock-out recovery: never serve HTTPS or move to it (e.g. after a broken certificate).
# TLS_DISABLE=true

# Instead of the built-in HTTPS, behind an HTTPS proxy (Caddy, nginx, …): trust its forwarded headers, so the app knows a
# request came over HTTPS (secure cookies) and from which address (sign-in lockout, activity
# log). Only when the app's port is reachable through the proxy alone. See docs/HTTPS.md.
# TRUST_PROXY=true

# Optional: API requests allowed per minute per signed-in session (default 1200; 0 = no limit).
# API_RATE_LIMIT=1200

# Optional: SESSION_SECRET. When unset, one is generated and kept in ./data/session-secret.

# Optional: for this many seconds after start the app shows its "still starting" screen
# (default 10; 0 turns it off).
# MIN_START_SECONDS=10
