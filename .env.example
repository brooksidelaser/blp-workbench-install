# BLP Workbench production settings (copy to .env next to compose.yaml).

# Version to run: a release tag such as v0.55b, or "latest" for the newest release.
BLP_VERSION=latest

# Optional: the updater (see compose.yaml). It carries out the updates and restarts started in
# Admin › Updates, and while support access is open it shows Brookside the app's and the
# database's logs (and a shell, only if you allow one when opening access). The installer sets
# these when you allow it; to add it later, set them and run docker compose up -d:
# - COMPOSE_PROFILES=updater turns it on.
# - INSTALL_DIR: this folder's full path (pwd in this folder).
# - DOCKER_CONFIG_DIR: the folder with the Docker login of the user who runs docker compose (its
#   config.json, e.g. /home/you/.docker or /root/.docker). The login must be in that file: a
#   credential helper ("credsStore" in config.json) can't be used.
# - DOCKER_SOCKET: only when this install runs on rootless Docker: that Docker's socket instead of
#   /var/run/docker.sock (docker context inspect -f '{{.Endpoints.docker.Host}}' shows it, run
#   as the user who runs docker compose). A wrong one leaves the updater without Docker.
# It needs BLP_VERSION=latest or v0.82b or later (older releases have no updater image). It works
# on the compose project named after this folder (or COMPOSE_PROJECT_NAME).
# COMPOSE_PROFILES=updater
# INSTALL_DIR=/home/you/blp-workbench
# DOCKER_CONFIG_DIR=/home/you/.docker
# DOCKER_SOCKET=/run/user/1000/docker.sock

# Container name: unique on this machine (letters, digits, - _ .), e.g. blp-workbench-test.
# The database's container is named the same with -db.
CONTAINER_NAME=blp-workbench

# The database's password (letters and digits; the installer makes a random one). Set it before
# the first start: the database keeps the one it was created with.
POSTGRES_PASSWORD=

# Host ports: the app over HTTP, and over HTTPS (served once Settings › HTTPS has a
# certificate). For Let's Encrypt use 80 and 443 (Let's Encrypt checks the domain on port 80).
# Each instance on this machine needs its own ports.
APP_PORT=7080
APP_HTTPS_PORT=7443

# Optional: the host user/group that owns ./data (default 1000:1000, the image's own user).
# APP_UID=1000
# APP_GID=1000

# Optional recovery admin. A new install asks for its first admin account on the setup page,
# so these aren't needed. If someone gets locked out, set both and run docker compose up -d:
# this account can sign in (as an admin) for the first ADMIN_LIFETIME minutes after the app
# starts (default 10; 0 = no limit, not recommended). After that it stops working, and is
# signed out, until the app is started again. Remove it again afterwards.
# ADMIN_USER=recovery
# ADMIN_PASS=
# ADMIN_LIFETIME=10

# The address users open (used in label QR codes and emailed links). With HTTPS, use the
# https:// address (plain HTTP pages then move to it): e.g. https://workbench.example.com
PUBLIC_URL=http://your-host.example.com:7080

# Optional: get a Let's Encrypt certificate for this domain on the first start (the installer
# sets these). Needs APP_PORT=80 and APP_HTTPS_PORT=443, and the domain pointing at this
# machine. Afterwards Admin › Settings › HTTPS manages it.
# TLS_DOMAIN=workbench.example.com
# TLS_EMAIL=you@example.com

# Lock-out recovery: never serve HTTPS or move to it (e.g. after a broken certificate).
# TLS_DISABLE=true

# Instead of the built-in HTTPS, behind an HTTPS proxy (Caddy, nginx, …): trust its forwarded headers, so the app knows a
# request came over HTTPS (secure cookies) and from which address (sign-in lockout, activity
# log). Only when the app's port is reachable through the proxy alone. See docs/HTTPS.md.
# TRUST_PROXY=true

# Optional: API requests allowed per minute per signed-in session (default 1200; 0 = no limit).
# API_RATE_LIMIT=1200

# Optional: SESSION_SECRET. When unset, one is generated and kept in ./data/session-secret
# (as is the app's own database password, in ./data/db-app-secret).

# Optional: for this many seconds after start the app shows its "still starting" screen
# (default 10; 0 turns it off).
# MIN_START_SECONDS=10
